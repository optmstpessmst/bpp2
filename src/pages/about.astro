    links: [
      { label: "Codeforces", href: "https://codeforces.com/profile/harvsftw", icon: "/codeforces.png" },
    ],
    blurb: "",
  },
    {
    name: "Krys Darilay",
    role: "Website, Editorials",
    image: "/team/krys.jpg",
    links: [
      { label: "Codeforces", href: "https://codeforces.com/profile/optmstpessmst", icon: "/codeforces.png" },
      { label: "GitHub", href: "https://github.com/optmstpessmst", icon: "https://upload.wikimedia.org/wikipedia/commons/9/91/Octicons-mark-github.svg?utm_source=commons.wikimedia.org&utm_campaign=index&utm_content=original"},
    ],
    blurb: "Studying mathematics at UP Diliman. NOI.PH Finalist 2026 and YTP TA 2026-2027. Loves graphs problems, music, and Fenwick trees!",
  },
  {
    name: "Yhuan Ceabastian Garcia",
    role: "Editorials",
    image: "/team/joon.jpg",
    links: [
      { label: "Codeforces", href: "https://codeforces.com/profile/YhuanDebeste", icon: "/codeforces.png" },
    ],
