---
import Layout from "../../components/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const problems = await getCollection("problems");
  return problems.map((problem) => ({
    params: { slug: problem.id },
    props: { problem },
  }));
}

const { problem } = Astro.props;
const { Content } = await render(problem);
const { title, contest, authors } = problem.data;
const problemId = problem.data.id ?? problem.id;
const editorials = await getCollection("editorials");
const relatedEditorials = await Promise.all(
  editorials
    .filter((editorial) => editorial.data.problemId === problemId)
    .sort((a, b) => a.id.localeCompare(b.id))
    .map(async (editorial) => ({
      data: editorial.data,
      Content: (await render(editorial)).Content,
    }))
);
---

<Layout title={title}>
  <br>
  <article>
    <a href="/problems">&larr; All problems</a>

    <header>
      <h1>{title}</h1>

      {contest && <p class="contest">{contest}</p>}

      {authors.length > 0 && (
        <p class="authors">
          By{" "}
          {authors.map((a, i) => (
            <>
              {a.url ? (
                <a href={a.url} target="_blank" rel="noopener noreferrer">{a.name}</a>
              ) : (
                a.name
              )}
              {a.role && ` (${a.role})`}
              {i < authors.length - 1 && ", "}
            </>
          ))}
        </p>
      )}
    </header>

    <Content />

    {relatedEditorials.map(({ data, Content: EditorialContent }, i) => (
      <details>
        <summary>Editorial {i + 1}</summary>
        <div class="editorial-content">
          <div class="editorial-meta">
            {data.authors.length > 0 && (
              <p class="editorial-authors" style="margin-top:0">
                Editorial written by{" "}
                {data.authors.map((a, j) => (
                  <>
                    {a.url ? (
                      <a href={a.url} target="_blank" rel="noopener noreferrer">{a.name}</a>
                    ) : (
                      a.name
                    )}
                    {j < data.authors.length - 1 && ", "}
                  </>
                ))}
              </p>
            )}
            {data.tags.length > 0 && (
              <div class="tags-row">
                <span class="tags-label">Tags:</span>
                <ul class="tags">
                  {data.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          <EditorialContent />
        </div>
      </details>
    ))}
  </article>
</Layout>

<style>
  header {
    margin-bottom: 2rem;
  }
  h1 {
    margin-bottom: 0.25rem;
  }
  .contest {
    margin: 0;
    font-weight: 600;
    color: #6b6b8a;
  }
  .authors {
    margin: 0.25rem 0 0;
  }
  article {
    padding: 0 5vw;
  }
  .editorials {
    margin-top: 3rem;
  }
  .editorials h2 {
    margin-bottom: 1rem;
  }
  details {
    border: 1px solid #d9d9e5;
    border-radius: 0.5rem;
    margin-bottom: 0.75rem;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.9rem 1rem;
  }
  .editorial-content {
    border-top: 1px solid #d9d9e5;
    padding: 1rem;
  }

  .editorial-meta {
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #d9d9e5;
  }
  .editorial-authors {
    margin: 0 0 0.6rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tags li {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: #1f1f3a;
    color: #fff;
  }

  .tags-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .tags-label {
    font-weight: 600;
    align-items: flex-start;
    padding-top: 0.25rem;
  }
</style>
