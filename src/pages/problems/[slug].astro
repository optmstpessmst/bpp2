---
import Layout from "../../components/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const problems = await getCollection("problems");
  return problems.map((problem) => ({
    params: { slug: problem.id },
    props: { problem },
  }));
}

const { problem } = Astro.props;
const { Content } = await render(problem);
const { title } = problem.data;
const problemId = problem.data.id ?? problem.id;

const [authorEntries, contestEntries, editorials] = await Promise.all([
  getCollection("authors"),
  getCollection("contests"),
  getCollection("editorials"),
]);

type AuthorData = (typeof authorEntries)[number]["data"];
type ContestData = (typeof contestEntries)[number]["data"];

const authorsById = new Map<string, AuthorData>(
  authorEntries.map(({ id, data }) => [id, data] as const)
);
const contestsById = new Map<string, ContestData>(
  contestEntries.map(({ id, data }) => [id, data] as const)
);

const authors = problem.data.authors.map(({ author, role }) => {
  const profile = authorsById.get(author);
  if (!profile) {
    throw new Error(`Unknown author "${author}" in problem "${problem.id}"`);
  }
  return { ...profile, role };
});

const contest = problem.data.contest
  ? contestsById.get(problem.data.contest)?.title ?? problem.data.contest
  : undefined;

const relatedEditorials = await Promise.all(
  editorials
    .filter((editorial) => editorial.data.problemId === problemId)
    .map(async (editorial) => ({
      data: editorial.data,
      Content: (await render(editorial)).Content,
    }))
);
---

<Layout title={title}>
  <br>
  <article>
    <a href="/problems">&larr; All problems</a>

    <header>
      <h1>{title}</h1>

      {contest && <p class="contest">{contest}</p>}

      {authors.length > 0 && (
        <p class="authors">
          By{" "}
          {authors.map((author, i) => (
            <>
              {author.url ? (
                <a href={author.url} target="_blank" rel="noopener noreferrer">
                  {author.name}
                </a>
              ) : (
                author.name
              )}
              {author.role && ` (${author.role})`}
              {i < authors.length - 1 && ", "}
            </>
          ))}
        </p>
      )}
    </header>

    <Content />

    {relatedEditorials.length > 0 && (
      <section class="editorials" aria-labelledby="editorials-heading">
        <h2 id="editorials-heading">Editorials</h2>
        {relatedEditorials.map(({ data, Content: EditorialContent }) => (
          <details>
            <summary>{data.title}</summary>
            <div class="editorial-content">
              <EditorialContent />
            </div>
          </details>
        ))}
      </section>
    )}
  </article>
</Layout>

<style>
  header {
    margin-bottom: 2rem;
  }
  h1 {
    margin-bottom: 0.25rem;
  }
  .contest {
    margin: 0;
    font-weight: 600;
    color: #6b6b8a;
  }
  .authors {
    margin: 0.25rem 0 0;
  }
  article {
    padding: 0 5vw;
  }
  .editorials {
    margin-top: 3rem;
  }
  .editorials h2 {
    margin-bottom: 1rem;
  }
  details {
    border: 1px solid #d9d9e5;
    border-radius: 0.5rem;
    margin-bottom: 0.75rem;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.9rem 1rem;
  }
  .editorial-content {
    border-top: 1px solid #d9d9e5;
    padding: 1rem;
  }
</style>
