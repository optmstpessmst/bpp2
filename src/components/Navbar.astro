---
const links = [
  { href: "/", label: "Home" },
  { href: "/problems", label: "Problems"},
  { href: "/editorials", label: "Editorials"},
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
];

const currentPath = Astro.url.pathname;
---

<nav>
  <a href="/" class="logo"><img src="/src/assets/bpp2_logo.png" style="height:2em"></a>
  <ul>
    {links.map(({ href, label }) => (
      <li>
        <a href={href} aria-current={currentPath === href ? "page" : undefined}>
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2vh 5vh;
    background: #1a1a2e;
  }
  ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    color: white;
    text-decoration: none;
  }
  a[aria-current="page"] {
    font-weight: bold;
    border-bottom: 2px solid white;
  }
</style>