---
import { compileTexDocument, compileTexSource } from "../lib/latexml";

interface Props {
  file?: string;
  raw?: string;
  sourceFilePath?: string;
}

const { file, raw, sourceFilePath } = Astro.props;
if ((file && raw) || (!file && !raw)) {
  throw new Error("Markdoc tex tag must provide either a file or TeX source.");
}
if (file && !sourceFilePath) {
  throw new Error("Missing sourceFilePath for Markdoc TeX attachment.");
}
const documentHtml = raw
  ? await compileTexSource(raw)
  : await compileTexDocument(file!, sourceFilePath!);
---
<iframe
  data-auto-resize
  srcdoc={documentHtml}
  width="100%"
  height="100%"
  loading="lazy"
  sandbox="allow-same-origin"
  style="border: 0;"
/>
<script>
  import "../scripts/iframe-resizer";
</script>
