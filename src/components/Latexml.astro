---
import { compileTexDocument, compileTexSource } from "../lib/latexml";

interface Props {
  file?: string;
  raw?: string;
  entryFilePath?: string;
}

const { file, raw, entryFilePath } = Astro.props;
if ((file && raw) || (!file && !raw)) {
  throw new Error("Markdoc tex tag must provide either a file or TeX source.");
}
const documentHtml = raw
  ? await compileTexSource(raw)
  : await compileTexDocument(file!, entryFilePath);
---
<iframe
  data-auto-resize
  srcdoc={documentHtml}
  width="100%"
  height="100%"
  loading="lazy"
  sandbox="allow-same-origin"
  style="border: 0;"
/>
<script>
  import "../scripts/iframe-resizer";
</script>
