---
import { compileTexDocument } from "../lib/latexml";

interface Props {
  file: string;
  width?: string;
  height?: string;
}

const { file, width = "100%", height = "900px" } = Astro.props;
const documentHtml = await compileTexDocument(file);
---
<iframe
  data-auto-resize
  srcdoc={documentHtml}
  width={width}
  height={height}
  loading="lazy"
  sandbox="allow-same-origin"
  style="border: 0;"
/>
<script>
  import "../scripts/iframe-resizer";
</script>