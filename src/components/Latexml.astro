---
import { compileTexDocument, compileTexSource } from "../lib/latexml";

interface Props {
  file?: string;
  raw?: string;
  width?: string;
  height?: string;
}

const { file, raw, width = "100%", height = "900px" } = Astro.props;
if ((file && raw) || (!file && !raw)) {
  throw new Error("Markdoc tex tag must provide either a file or TeX source.");
}
const documentHtml = raw ? await compileTexSource(raw) : await compileTexDocument(file!);
---
<iframe
  data-auto-resize
  srcdoc={documentHtml}
  width={width}
  height={height}
  loading="lazy"
  sandbox="allow-same-origin"
  style="border: 0;"
/>
<script>
  import "../scripts/iframe-resizer";
</script>
