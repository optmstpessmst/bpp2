---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_FONT_FAMILY, SITE_FONT_STYLESHEET } from "../lib/fonts";
import "katex/dist/katex.min.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/bpp2.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href={SITE_FONT_STYLESHEET} rel="stylesheet">
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style is:global define:vars={{ siteFontFamily: SITE_FONT_FAMILY }}>
  html,
  body {
    height: 100%;
    margin: 0;
  }
  body {
    margin: 0;
    font-family: var(--siteFontFamily);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    padding: 1vh 5vw;
    flex: 1;
  }
</style>
